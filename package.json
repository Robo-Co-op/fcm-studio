{
  "name": "fcm-studio",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:cloud": "playwright test --config playwright.cloud.config.ts",
    "server": "node server/index.mjs",
    "lint": "eslint .",
    "gate": "node scripts/gate.mjs",
    "format": "prettier --write src server tests *.ts *.js *.json *.md"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.115.0",
    "@xyflow/react": "^12.8.0",
    "exceljs": "^4.4.0",
    "html-to-image": "^1.11.13",
    "idb-keyval": "^6.2.2",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.9.6",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22"
  }
}
